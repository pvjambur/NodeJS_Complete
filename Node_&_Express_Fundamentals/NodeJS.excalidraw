    {
      "id": "1oEJFd9FX0INIc4YmgO8h",
      "type": "text",
      "x": 2551.57376036954,
      "y": 383.17009078592514,
      "width": 443.0997009277344,
      "height": 200,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 1268420199,
      "version": 26,
      "versionNonce": 1342435431,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795776694497,
      "link": null,
      "locked": false,
      "text": "const http = require('http');\n\nconst server = http.createServer((req,res)=>{\n    res.write('Welcome to our home page');\n    res.end();\n})\n\nserver.listen(5000)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const http = require('http');\n\nconst server = http.createServer((req,res)=>{\n    res.write('Welcome to our home page');\n    res.end();\n})\n\nserver.listen(5000)",
      "autoResize": true,
      "lineHeight": 1.25
    },
