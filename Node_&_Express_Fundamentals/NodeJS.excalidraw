    {
      "id": "y-iCn3aU29j1WicWuxGZI",
      "type": "text",
      "x": 2541.8927964071027,
      "y": 747.6928384230235,
      "width": 636.9396362304688,
      "height": 425,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b21",
      "roundness": null,
      "seed": 433542313,
      "version": 37,
      "versionNonce": 468373799,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795777066139,
      "link": null,
      "locked": false,
      "text": "const http = require('http');\n\nconst server = http.createServer((req,res)=>{\n    if (req.url ==='/'){\n        res.end('Welcome to our home page');\n    }\n    if (req.url === '/about'){\n        res.end('Here is our short history')\n    }\n    res.end(`\n        <h1> Oops! </h1>\n        <p>We can't seem to find the page you are looking for</p>\n        <a href='/'>back home</a>\n        `)\n})\n\nserver.listen(5000);",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const http = require('http');\n\nconst server = http.createServer((req,res)=>{\n    if (req.url ==='/'){\n        res.end('Welcome to our home page');\n    }\n    if (req.url === '/about'){\n        res.end('Here is our short history')\n    }\n    res.end(`\n        <h1> Oops! </h1>\n        <p>We can't seem to find the page you are looking for</p>\n        <a href='/'>back home</a>\n        `)\n})\n\nserver.listen(5000);",
      "autoResize": true,
      "lineHeight": 1.25
    },
