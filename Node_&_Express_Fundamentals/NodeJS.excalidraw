    },
    {
      "id": "86vhw4SaE5ARfspUhDbVV",
      "type": "text",
      "x": 1897.3468485855083,
      "y": 1574.8388278228426,
      "width": 528.0396118164062,
      "height": 625,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1S",
      "roundness": null,
      "seed": 807716519,
      "version": 5,
      "versionNonce": 457489191,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795768297965,
      "link": null,
      "locked": false,
      "text": "readFile('./content/first.txt','utf8',(err,result)=>{\n    if (err){\n        console.log(err);\n        return;\n    }\n    const first = result;\n    readFile('./content/second.txt','utf8',(err,result)=>{\n        if  (err){\n            console.log(err);\n            return;\n        }\n        const second = result;\n        writeFile(\n            './content/result-async.txt',\n            `Here is the reuslt: ${first}, ${second}`\n            ,(err,result)=>{\n                if (err){\n                    console.log(err);\n                    return;\n                }\n                console.log(result)\n            }\n        )\n    })\n})",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "readFile('./content/first.txt','utf8',(err,result)=>{\n    if (err){\n        console.log(err);\n        return;\n    }\n    const first = result;\n    readFile('./content/second.txt','utf8',(err,result)=>{\n        if  (err){\n            console.log(err);\n            return;\n        }\n        const second = result;\n        writeFile(\n            './content/result-async.txt',\n            `Here is the reuslt: ${first}, ${second}`\n            ,(err,result)=>{\n                if (err){\n                    console.log(err);\n                    return;\n                }\n                console.log(result)\n            }\n        )\n    })\n})",
      "autoResize": true,
      "lineHeight": 1.25
    },
