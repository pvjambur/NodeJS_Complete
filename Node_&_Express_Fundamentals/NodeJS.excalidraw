    },
    {
      "id": "dWC_QvBlfUyRikqG0LXKG",
      "type": "text",
      "x": 1887.6271935706327,
      "y": 1199.3380607001259,
      "width": 563.799560546875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1P",
      "roundness": null,
      "seed": 1353490985,
      "version": 46,
      "versionNonce": 1425269927,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795768036698,
      "link": null,
      "locked": false,
      "text": "const {readFile,writeFile} = require('fs');\n//we need a call back for the above asynchronous method\n\nreadFile('./content/first.txt','utf8',(err,result)=>{\n    if (err){\n        console.log(err);\n        return;\n    }\n    console.log(result)\n})",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const {readFile,writeFile} = require('fs');\n//we need a call back for the above asynchronous method\n\nreadFile('./content/first.txt','utf8',(err,result)=>{\n    if (err){\n        console.log(err);\n        return;\n    }\n    console.log(result)\n})",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5_V6r6dd24uvsTI3KtyHc",
      "type": "rectangle",
      "x": 1882.4434335906983,
      "y": 1189.9424370306867,
      "width": 576.6966470885379,
      "height": 268.58510576025583,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
