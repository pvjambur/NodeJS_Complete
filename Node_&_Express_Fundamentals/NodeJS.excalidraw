    {
      "id": "YfqQ0bBoaGHBvP8BEWEQn",
      "type": "text",
      "x": 2537.6981169871096,
      "y": 1594.4705342479933,
      "width": 657.719482421875,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2A",
      "roundness": null,
      "seed": 895612201,
      "version": 640,
      "versionNonce": 573303431,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795778197431,
      "link": null,
      "locked": false,
      "text": "Basic commnads:\n\nnpm --v:  11.17.0 (Gives the version number of npm)\nnpm -> global command\nnpm i <packageName> -> install for local dependencies\n\nFor global dependencies:\n\nnpm install -g <packageName>\nsudo npm install -g <packageName> (mac) \n\n\nOther elements:\n\npackage.json -> manifest file (stores important info about project/\n    package)\n\n{manual approach -> create packet.json and create properties}\n\nnpm init -> step by step, press enter\nnpm init -y -> (everything done by default)\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Basic commnads:\n\nnpm --v:  11.17.0 (Gives the version number of npm)\nnpm -> global command\nnpm i <packageName> -> install for local dependencies\n\nFor global dependencies:\n\nnpm install -g <packageName>\nsudo npm install -g <packageName> (mac) \n\n\nOther elements:\n\npackage.json -> manifest file (stores important info about project/\n    package)\n\n{manual approach -> create packet.json and create properties}\n\nnpm init -> step by step, press enter\nnpm init -y -> (everything done by default)\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
