    {
      "id": "C7bM6gJj9rwUI7wmg5K6U",
      "type": "text",
      "x": 1451.9906366231824,
      "y": 1537.5938161461822,
      "width": 346.259765625,
      "height": 650,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": null,
      "seed": 1095734075,
      "version": 381,
      "versionNonce": 77905033,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795766171203,
      "link": null,
      "locked": false,
      "text": "For accessing the os module:\n\nconst os = require('os')\n\n\nTo access user info we can do:\n\nconst user = os.userInfo()\nconsole.log(user)\n\nTo measure system uptime we need:\n\nconst time = os.uptime()\nconsole.log(`${time} seconds`)\n\n\nTo know more about the system:\n\nconst currentos = {\n    name: os.type(),\n    release: os.release(),\n    totalMem: os.totalmem(),\n    freeMem: os.freemem(),\n\n}\nconsole.log(currentos)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For accessing the os module:\n\nconst os = require('os')\n\n\nTo access user info we can do:\n\nconst user = os.userInfo()\nconsole.log(user)\n\nTo measure system uptime we need:\n\nconst time = os.uptime()\nconsole.log(`${time} seconds`)\n\n\nTo know more about the system:\n\nconst currentos = {\n    name: os.type(),\n    release: os.release(),\n    totalMem: os.totalmem(),\n    freeMem: os.freemem(),\n\n}\nconsole.log(currentos)",
      "autoResize": true,
      "lineHeight": 1.25
    },
