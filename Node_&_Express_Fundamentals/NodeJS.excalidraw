      "text": "Reading a file using an asynchronous method:\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reading a file using an asynchronous method:\n\n",
